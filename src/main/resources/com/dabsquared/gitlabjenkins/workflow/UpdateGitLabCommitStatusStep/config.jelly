<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Build name}" field="name" help="/plugin/gitlab-plugin/help/help-buildName.html">
    <f:textbox default="jenkins"/>
  </f:entry>
  <f:entry title="${%Build state}" field="state" help="/plugin/gitlab-plugin/help/help-buildState.html">
    <f:select/>
  </f:entry>
  <!-- Unchecked submits false (explicit opt-out); only an omitted (null) argument inherits the global default. -->
  <f:entry title="${%Attach commit status to merge request pipeline}" field="attachStatusToMergeRequestPipeline" help="/plugin/gitlab-plugin/help/help-attachStatusToMergeRequestPipeline.html">
    <f:checkbox/>
  </f:entry>
</j:jelly>
